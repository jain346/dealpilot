# DealPilot - Environment Variables
# Copy this file to .env and fill in your API keys

# Parallel AI API Key (get yours at https://platform.parallel.ai)
PARALLEL_API_KEY=

# Google Gemini API Key (for the ADK agent's LLM)
GOOGLE_API_KEY=

# SQLite path for local user accounts, conversations, and messages
DEALPILOT_DATABASE_PATH=dealpilot.db

# Optional: separate SQLAlchemy URL for persistent ADK session/event state.
# Defaults to the SQLite database above.
# DEALPILOT_ADK_DATABASE_URL=sqlite+aiosqlite:///absolute/path/to/dealpilot.db

# Application logging. Logs are JSON lines on stdout by default.
DEALPILOT_LOG_LEVEL=INFO
# Optional rotating log file path, for example: logs/dealpilot.log
# DEALPILOT_LOG_FILE=
DEALPILOT_LOG_MAX_BYTES=10485760
DEALPILOT_LOG_BACKUP_COUNT=5
